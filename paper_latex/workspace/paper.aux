\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Recall at precision $\geq $0.90 across methods on GLUE MRPC paraphrase detection. MinHash Jaccard achieves 0.364 recall, landmark-pair achieves 0.109. Removing positional offset improves landmark-pair to 0.152, indicating offset adds noise. MinHash Containment fails completely (0.0) on paraphrases, suggesting asymmetric metrics handle length mismatch but struggle with semantic variation.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:mrpc_results}{{1}{5}{Recall at precision $\geq $0.90 across methods on GLUE MRPC paraphrase detection. MinHash Jaccard achieves 0.364 recall, landmark-pair achieves 0.109. Removing positional offset improves landmark-pair to 0.152, indicating offset adds noise. MinHash Containment fails completely (0.0) on paraphrases, suggesting asymmetric metrics handle length mismatch but struggle with semantic variation}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Performance on GLUE MRPC paraphrase detection.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:mrpc}{{1}{5}{Performance on GLUE MRPC paraphrase detection}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Results on GLUE MRPC}{5}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Results on Synthetic Structural Edits}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Recall at precision $\geq $0.90 across all methods on synthetic structural-edit variants. All methods achieve perfect recall (1.0) across insertion, deletion, reordering, and embedding variants. This indicates the synthetic benchmark's shared-text assumption makes the problem trivial---all modern methods exploit high Jaccard overlap in the preserved core.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:synthetic_results}{{2}{6}{Recall at precision $\geq $0.90 across all methods on synthetic structural-edit variants. All methods achieve perfect recall (1.0) across insertion, deletion, reordering, and embedding variants. This indicates the synthetic benchmark's shared-text assumption makes the problem trivial---all modern methods exploit high Jaccard overlap in the preserved core}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Recall@P$\geq $0.90 on synthetic structural edits. All methods achieve perfect recall (1.0).}}{6}{table.2}\protected@file@percent }
\newlabel{tab:synthetic}{{2}{6}{Recall@P$\geq $0.90 on synthetic structural edits. All methods achieve perfect recall (1.0)}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Ablation: Positional Offset is Harmful}{6}{subsection.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Ablation study: effect of positional offset on landmark-pair performance.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:ablation}{{3}{6}{Ablation study: effect of positional offset on landmark-pair performance}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Effect of removing positional offset from landmark-pair hashing. On MRPC, recall improves from 0.109 (with offset) to 0.152 (without offset). Difference significant at $\alpha =0.05$ ($z=-4.68$, $p<0.001$). On synthetic data, no difference (both achieve 1.0). Offset acts as noise on realistic text.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:ablation}{{3}{7}{Effect of removing positional offset from landmark-pair hashing. On MRPC, recall improves from 0.109 (with offset) to 0.152 (without offset). Difference significant at $\alpha =0.05$ ($z=-4.68$, $p<0.001$). On synthetic data, no difference (both achieve 1.0). Offset acts as noise on realistic text}{figure.3}{}}
